# StructAI MCP Server —— 环境变量样例（P01 Bootstrap / P02 Config）
#
# 用法：复制为 .env 后按需修改；.env 已被 .gitignore 忽略，绝不入库。
# 约定：变量名 = Settings 字段名的大写形式（pydantic-settings 默认行为），
#       字段清单见 docs/02 §5 / §5.1，已落地于 P02（app/config/settings.py）。
# 安全：任何真实密钥（MAPI-Key / token / 口令 / 私钥）都不得写入本文件或任何入库文件，
#       只能经运行环境注入（docs/07 §8.5、§14.3）。

# ===== 应用 =====
APP_NAME=StructAI MCP Server
APP_VERSION=2.0.0-alpha
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ===== 数据库 =====
# Core Alpha = SQLite(aiosqlite)；生产可切 PostgreSQL（postgresql+asyncpg://...）
DATABASE_URL=sqlite+aiosqlite:///./data/structai.db
SQL_ECHO=false

# ===== MCP 传输（P40 STDIO / P41 Streamable HTTP）=====
MCP_TRANSPORT=stdio
HOST=127.0.0.1
PORT=7860

# ===== 任务 / 存储 / 超时 =====
TASK_WORKER_COUNT=4
ARTIFACT_ROOT=./data/artifacts
SESSION_EXPIRE_SECONDS=86400
TASK_DEFAULT_TIMEOUT_SECONDS=3600
LOCK_DEFAULT_TIMEOUT_SECONDS=300
CAPABILITY_CACHE_SECONDS=300

# 注：RuntimeConfig 的运行期参数（shutdown_timeout_seconds / task_poll_interval_seconds /
#     lease_seconds / heartbeat_seconds）不是环境变量，取 app/config/runtime_config.py 的规范默认值。

# ===== P07 Seed：管理员引导口令（docs/02 §43 / §44）=====
# 只用于 `python -m app.infrastructure.database.seed`：把口令转成 Argon2id
# password_hash 后写入 users 表；库中**只**保存 password_hash。
# 该变量名由 docs/02 §43 固定为 STRUCTAI_BOOTSTRAP_ADMIN_PASSWORD，不是 Settings
# 该变量名由 docs/02 §43 固定为 STRUCTAI_BOOTSTRAP_ADMIN_PASSWORD，不是 Settings
# 字段名的大写形式（docs/08 §4），因此由 Seed 直接读**进程环境变量**：
# pydantic-settings 读 `.env` 只填充 Settings 字段，**不会**写进 os.environ，
# 所以口令必须导出到运行环境（如 `$env:STRUCTAI_BOOTSTRAP_ADMIN_PASSWORD = "..."`），
# 仅写进 `.env` 不生效。
# ⚠️ 真实口令绝不写入本文件 / 仓库 / 日志：只在运行环境注入。
# STRUCTAI_BOOTSTRAP_ADMIN_PASSWORD=
# ===== MIDAS 实例（P119+ 才使用；此处只登记变量名，值一律留空）=====
# 涉及 MIDAS API 一律以 registry/ 为唯一权威来源；凭证只经环境变量传入。
# MIDAS_BASE_URL=
# MIDAS_MAPI_KEY=
