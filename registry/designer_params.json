  "DB/DCOD": {
   "uri": "/DB/DCOD",
   "sections": [
    {
     "title": "规范设置",
     "params": [
      {
       "name": "DimType",
       "type": "integer",
       "required": false,
       "description": "设计内力<br>*0-二维 1-二维+扭矩 2-三维"
      },
      {
       "name": "SafeType",
       "type": "integer",
       "required": false,
       "description": "公路桥涵结构的设计安全等级<br>*0-一级 1-二级 2-三级"
      },
      {
       "name": "CastType",
       "type": "integer",
       "required": false,
       "description": "构件制作方法<br>*0-预制 1-现浇"
      },
      {
       "name": "BrgType",
       "type": "integer",
       "required": false,
       "description": "构件类型<br>*0-全预应力 1-A类 2-B类"
      },
      {
       "name": "CrackWidth",
       "type": "array",
       "required": false,
       "description": "环境设置<br>*0-I类-一般环境 1-II类-冻融环境 2-III类-海洋氯化物环境 3-IV类-除冰盐等其他氯化物环境 4-V类-盐结晶环境 5-VI类-化学腐蚀环境 6-VII类-磨蚀环境"
      },
      {
       "name": "CalcBtType",
       "type": "integer",
       "required": false,
       "description": "抗扭降低系数βt<br>*0-翼缘+腹板 1-腹板"
      },
      {
       "name": "Mesh",
       "type": "boolean",
       "required": false,
       "description": "是否采用网格划分"
      },
      {
       "name": "MeshSize",
       "type": "number",
       "required": false,
       "description": "网格尺寸"
      },
      {
       "name": "WeldSkeleton",
       "type": "boolean",
       "required": false,
       "description": "RC构件是否采用焊接钢筋骨架"
      },
      {
       "name": "WeldSkeletoFactor",
       "type": "number",
       "required": false,
       "description": "RC构件采用焊接钢筋骨架系数"
      },
      {
       "name": "Consider",
       "type": "number",
       "required": false,
       "description": "预应力弯起钢筋考虑"
      },
      {
       "name": "fcup",
       "type": "number",
       "required": false,
       "description": "施工阶段应力验算fcu’"
      },
      {
       "name": "MatlStrength",
       "type": "integer",
       "required": false,
       "description": "柱P-M验算材料强度<br>*0-标准值 1-设计值"
      },
      {
       "name": "Option1",
       "type": "array",
       "required": false,
       "description": "验算选项RC<br>*从上到下true-勾选 false-不勾选"
      },
      {
       "name": "Option2",
       "type": "array",
       "required": false,
       "description": "验算选项PSC<br>*从上到下true-勾选 false-不勾选"
      }
     ]
    }
