       "description": "激活方式<br>*0-全部构件 1-指定单元号对应的构件 2-指定构件 3-指定结构组对应的构件"
      },
      {
       "name": "KeyList",
       "type": "array",
       "required": false,
       "description": "单元号<br>*仅\"Type\"为1时有效"
      },
      {
       "name": "NameList",
       "type": "array",
       "required": false,
       "description": "构件名称、结构组名称<br>*仅\"Type\"为2、3时有效"
      }
     ]
    }
   ]
  },
  "VIEW/ANGLE": {
   "uri": "/VIEW/ANGLE",
   "sections": [
    {
     "title": "视角",
     "params": [
      {
       "name": "Type",
       "type": "integer",
       "required": true,
       "description": "视角类型<br>*0-轴测图1 1-轴测图2 2-后视图 3-前视图 4-俯视图 5-仰视图 6-左视图 7-右视图 8-左上 9-左下 10-右上 11-右下 12-初始视图"
      }
     ]
    }
   ]
  },
  "VIEW/DISPLAY": {
   "uri": "/VIEW/DISPLAY",
   "sections": [
    {
     "title": "显示",
     "params": [
      {
       "name": "Structure",
       "type": "object",
       "required": false,
       "description": "结构显示设置"
      },
      {
       "name": "Boundary",
       "type": "object",
       "required": false,
       "description": "边界显示设置"
      },
      {
       "name": "DgnParam",
       "type": "object",
       "required": false,
       "description": "设计参数显示设置"
      },
      {
       "name": "Result",
       "type": "object",
       "required": false,
       "description": "结果显示设置"
      }
     ]
    }
   ]
  },
  "VIEW/CAPTURE": {
   "uri": "/VIEW/CAPTURE",
   "sections": [
    {
     "title": "截图",
     "params": [
      {
       "name": "Active",
       "type": "object",
       "required": false,
       "description": "激活对象"
      },
      {
       "name": "Angle",
       "type": "object",
       "required": false,
       "description": "视角设置"
      },
      {
       "name": "Display",
       "type": "object",
       "required": false,
       "description": "显示设置"
      },
      {
       "name": "FilePath",
       "type": "string",
       "required": true,
       "description": "截图保存路径"
      }
     ]
    }
   ]
  },
  "POST/TABLE": {
   "uri": "/POST/TABLE",
   "sections": [
    {
     "title": "表格提取",
     "params": [
      {
       "name": "Type",
       "type": "integer",
       "required": true,
       "description": "获取结果表格方式<br>*0-全部构件 1-指定构件号 2-指定单元号对应的构件 3-指定构件名称"
      },
      {
       "name": "KeyList",
       "type": "array",
       "required": false,
       "description": "构件号、单元号<br>*仅Type为1,2时有效，未设置时输出全部构件表格"
      },
      {
       "name": "NameList",
       "type": "array",
       "required": false,
       "description": "构件名称<br>*仅Type为3时有效，未设置时输出全部构件"
      },
      {
       "name": "OptionList",
       "type": "array",
       "required": true,
       "description": "需要输出的结果表格索引列表 <br>*序号0-N"
      },
      {
       "name": "FilePath",
       "type": "string",
       "required": false,
       "description": "JSON文件保存路径<br>*未设置时不输出JSON文件；设置时输出JSON文件到指定路径"
      }
     ]
    }
   ]
  }
 }
