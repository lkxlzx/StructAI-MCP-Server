                    "type": "string",
                    "description": "Select input method for Part B",
                    "oneOf": [
                      {
                        "title": "Specify each Element ID",
                        "const": "KEYS"
                      },
                      {
                        "title": "Specify ID range",
                        "const": "TO"
                      }
                    ]
                  },
                  "KEYS": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "minItems": 1,
                    "description": "Specify each Element ID"
                  },
                  "TO": {
                    "type": "string",
                    "description": "Specify ID range (e.g. \"101 to 105\")"
                  }
                }
              },
              "PART_C": {
                "type": "object",
