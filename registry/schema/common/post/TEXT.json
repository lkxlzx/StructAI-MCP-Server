                  "description": "Method2:SpecifyIDRange"
                }
              }
            },
            "TH_CASE_NAME": {
              "type": "array",
              "description": "TimeHistoryLoadCases",
              "items": {
                "type": "string"
              }
            },
            "STEP": {
              "type": "object",
              "description": "OutputTimeStep",
              "properties": {
                "FROM": {
                  "type": "number",
                  "description": "StartTime"
