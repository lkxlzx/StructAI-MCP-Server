{
  "key": "POST.TEXT",
  "uri": "POST/TEXT",
  "source": "help_center",
  "schema": {
    "TEXT": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "Argument": {
          "type": "object",
          "properties": {
            "TABLE_TYPE": {
              "type": "string",
              "description": "ResultTableType",
              "enum": [
                "TH_DISP",
                "TH_VELOCITY",
                "TH_ACCEL"
              ]
            },
            "EXPORT_PATH": {
              "type": "string",
              "description": "ResultTableSavePath"
            },
            "UNIT": {
              "type": "object",
              "description": "ResponseUnitSetting",
              "properties": {
                "FORCE": {
                  "type": "string",
                  "description": "Force"
                },
                "DIST": {
                  "type": "string",
                  "description": "Length"
                },
                "HEAT": {
                  "type": "string",
                  "description": "Heat"
                },
                "TEMP": {
                  "type": "string",
                  "description": "Temperature"
                }
              }
            },
            "STYLES": {
              "type": "object",
