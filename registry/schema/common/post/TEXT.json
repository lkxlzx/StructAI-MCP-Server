                },
                "STEPS": {
                  "type": "integer",
                  "description": "TimeInterval"
                }
              }
            },
            "REF_PT": {
              "type": "string",
              "description": "ReferencePoint-Method1",
              "enum": [
                "Ground",
                "AddGroundMotion"
