{
  "key": "DB.REBW",
  "uri": "DB/REBW",
  "source": "repo_midas_api",
  "schema": {
    "type": "object",
    "required": [
      "Assign"
    ],
    "properties": {
      "Assign": {
        "type": "object",
        "description": "키는 벽체 ID 문자열 (예: \"1\")",
        "patternProperties": {
          "^[0-9]+$": {
            "type": "object",
            "required": [
              "ITEMS"
            ],
            "properties": {
              "ITEMS": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "ID": {
                      "type": "integer",
                      "description": "ID"
                    },
                    "bUSE_MODEL_THICK": {
                      "type": "boolean",
                      "description": "Use Model Thickness"
                    },
                    "THICK": {
                      "type": "number",
                      "description": "Thickness (Input check-off Use Model Thickness)"
                    },
                    "DW": {
                      "type": "number",
                      "description": "Dw (Concrete Face ~ Rebar Center)"
                    },
                    "DE": {
                      "type": "number",
                      "description": "De (Concrete Face ~ Rebar Center)"
                    },
                    "VER_BAR": {
                      "type": "object",
                      "description": "Vertical Rebar",
                      "properties": {
                        "NAME": {
                          "type": "string",
                          "description": "Name"
                        },
                        "DIST": {
                          "type": "number",
                          "description": "Space"
                        }
                      }
                    },
                    "HOR_BAR": {
                      "type": "object",
                      "description": "Horizontal Rebar",
                      "properties": {
                        "NAME": {
                          "type": "string",
                          "description": "Name"
                        },
                        "DIST": {
                          "type": "number",
                          "description": "Space"
                        }
                      }
                    },
                    "END_BAR": {
                      "type": "object",
                      "description": "End Rebar",
                      "properties": {
                        "NAME": {
                          "type": "string",
                          "description": "Name"
                        },
                        "DIST": {
                          "type": "number",
                          "description": "Space"
                        }
                      }
                    },
                    "NUM_END_BAR": {
                      "type": "integer",
                      "description": "End Rebar Num"
                    },
                    "BE_HOR_BAR": {
                      "type": "object",
                      "description": "Boundary Element Horizontal Rebar",
                      "properties": {
                        "NAME": {
                          "type": "string",
                          "description": "Name"
                        },
                        "DIST": {
                          "type": "number",
                          "description": "Space"
                        }
                      }
                    },
                    "BE_LENGTH": {
                      "type": "number",
                      "description": "Boundary Element Length"
                    },
                    "vSTORY_NAME": {
                      "type": "array",
                      "description": "Story Key List",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "description": "⚠️ 手册里**一个字段名都不对**（长名 `VERTICAL_REBAR`/`HORIZONTAL_REBAR`/`STORY:{FROM,TO}`/`THICKNESS`… vs 原生短名 `VER_BAR`/`HOR_BAR`/`vSTORY_NAME`（字符串数组，**不是** `{FROM,TO}` 范围）/`THICK`…）。实测（2026-07-29，真实生产模型 4044 节点/4686 单元）：`GET` 回显 + `/info` + **`PUT` 往返（改→验证→改回）** 三次独立确认 ⇒ 是**写契约**，不只是读。R144 / MD-34 / 实测发现 A-01。"
              }
            }
          }
        }
      }
    }
  },
  "response": {
    "direction": "response",
    "source": "l4_measured_envelope",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "REBW"
      ],
      "properties": {
        "REBW": {
          "type": "object"
        }
      }
    }
  }
}
