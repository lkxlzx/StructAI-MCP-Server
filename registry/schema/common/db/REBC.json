{
  "key": "DB.REBC",
  "uri": "DB/REBC",
  "source": "repo_midas_api",
  "schema": {
    "type": "object",
    "required": [
      "Assign"
    ],
    "properties": {
      "Assign": {
        "type": "object",
        "description": "키는 단면 번호 문자열 (예: \"1\")",
        "minProperties": 1,
        "patternProperties": {
          "^[0-9]+$": {
            "type": "object",
            "required": [
              "ITEMS"
            ],
            "properties": {
              "ITEMS": {
                "type": "array",
                "description": "⚠️ 手册与官方文章给**单个 `MAIN_BAR` 对象** + 顶层 `DO`；原生收 **`vMAIN_BAR` 数组**（每项含 `D0`，数字零）。实测（2026-08-27）：照手册发 → `Wrong Field`（形状被拒）；数组形状 → 域错误（形状被接受、目标缺失），且 POST→GET→PUT→DELETE→GET 往返成功 ⇒ 同时推翻手册的「POST only」。R144 / MD-34 / 实测发现 A-02。",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "ID": {
                      "type": "integer",
                      "description": "ID"
                    },
                    "vMAIN_BAR": {
                      "type": "array",
                      "description": "Main Bar List",
                      "items": {
                        "type": "object",
                        "properties": {
                          "NAME": {
                            "type": "string",
                            "description": "Main Name"
                          },
                          "NUM": {
                            "type": "integer",
                            "description": "Number"
                          },
                          "ROW": {
                            "type": "integer",
                            "description": "Row"
                          },
                          "D0": {
                            "type": "number",
                            "description": "Concrete Face ~ Center of Rebar"
                          },
                          "bUSE_CORNER": {
                            "type": "boolean",
                            "description": "Use Corner Bar"
                          },
                          "NAME_CORNER": {
                            "type": "string",
                            "description": "Corner Name"
                          }
                        }
                      }
                    },
                    "SHEAR_BAR_END": {
                      "type": "object",
                      "description": "Shear Bar-End",
                      "properties": {
                        "NAME": {
                          "type": "string",
                          "description": "Name"
                        },
                        "LEG_Y": {
                          "type": "integer",
                          "description": "Leg y"
                        },
                        "LEG_Z": {
                          "type": "integer",
                          "description": "Leg z"
                        },
                        "DIST": {
                          "type": "number",
                          "description": "Dist"
                        }
                      }
                    },
                    "SHEAR_BAR_CEN": {
                      "type": "object",
                      "description": "Shear Bar-Center",
                      "properties": {
                        "NAME": {
                          "type": "string",
                          "description": "Name"
                        },
                        "LEG_Y": {
                          "type": "integer",
                          "description": "Leg y"
                        },
                        "LEG_Z": {
                          "type": "integer",
                          "description": "Leg z"
                        },
                        "DIST": {
                          "type": "number",
                          "description": "Dist"
                        }
                      }
                    },
                    "HOOP_TYPE": {
                      "type": "integer",
                      "description": "Hoop Type (1=Tied, 2=Spiral)"
                    },
                    "bSAME_SPACE_END_CEN": {
                      "type": "boolean",
                      "description": "Same Rebar Spaces at End and Center"
                    },
                    "NUM_BAR_BC_JOINT": {
                      "type": "integer",
                      "description": "Number of Rebars of Beam-Column Joint"
                    },
                    "HOOK_TYPE": {
                      "type": "integer",
                      "enum": [
                        0,
                        1
                      ],
                      "description": "Hook Type (0: 90+(135 or 180) / 1: Both(135 or 180))"
                    }
                  },
                  "required": [
                    "SHEAR_BAR_END",
                    "SHEAR_BAR_CEN"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "response": {
    "direction": "response",
    "source": "l4_measured_envelope",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "REBC"
      ],
      "properties": {
        "REBC": {
          "type": "object"
        }
      }
    }
  }
}
