        },
        "INCRE_STEP": {
          "description": "IncrementSteps",
          "type": "integer"
        },
        "bCONS_PDELTA": {
          "description": "ConsiderP-DeltaEffect",
          "type": "boolean"
        },
        "bUSEINITIAL": {
          "description": "UseInitialLoad",
          "type": "boolean"
        },
        "bREACOUTPUT": {
          "description": "CumulativeReaction/StoryShearbyInitialLoad",
          "type": "boolean"
        },
        "INCRE_METHOD": {
          "description": "IncrementMethod",
