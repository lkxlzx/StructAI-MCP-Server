{
  "key": "OPE.BMLD",
  "uri": "OPE/BMLD",
  "source": "civil_nx_manual",
  "schema": {
    "title": "Beam Detail Analysis Request",
    "type": "object",
    "description": "Request body for beam detail stress analysis at a selected element and load case.",
    "required": [
      "Argument"
    ],
    "additionalProperties": false,
    "properties": {
      "Argument": {
        "type": "object",
        "required": [
          "LOAD_CASE_COMB",
          "ELEMENT",
          "STRESS_TYPE"
        ],
        "additionalProperties": false,
        "properties": {
          "LOAD_CASE_COMB": {
            "type": "object",
            "description": "Load case and combination selection. Moving Load (MV) is not supported by Beam Detail Analysis. Load combinations containing one or more Moving Load cases are also not supported.",
            "required": [
              "TYPE",
              "NAME",
              "STEP_INDEX"
            ],
            "additionalProperties": false,
            "properties": {
              "TYPE": {
                "type": "string",
                "description": "Load case type. Supported types: ST = Static Load, CS = Construction Stage, RS = Response Spectrum, TH = Time History; Load Combination types = CB, CBS, CBCF, CBC, CBF, CBR, CBA, CBSC, CBSM, CBLN; additional supported types = NRS, ES, NES, CN, EN. Moving Load (MV) is not supported.",
                "enum": [
                  "ST",
                  "CS",
                  "RS",
                  "TH",
                  "CB",
                  "CBS",
                  "CBCF",
                  "CBC",
                  "CBF",
                  "CBR",
                  "CBA",
                  "CBSC",
                  "CBSM",
                  "CBLN",
                  "NRS",
                  "ES",
                  "NES",
                  "CN",
                  "EN"
                ]
              },
              "MINMAX": {
                "type": "string",
                "description": "Load type for envelope results.",
                "enum": [
                  "Max",
                  "Min",
                  "All"
                ],
                "default": "Max"
              },
              "NAME": {
                "type": "string",
                "description": "Load name.",
                "minLength": 1
              },
              "STAGE_NAME": {
                "type": "string",
                "description": "Construction stage name."
              },
              "STEP_INDEX": {
                "type": "integer",
                "description": "Step of load case."
              }
            }
          },
          "ELEMENT": {
            "type": "integer",
            "description": "Beam element number.",
            "minimum": 1
          },
          "ELEM_POS_RATIO": {
            "type": "number",
            "description": "Result position along the beam element measured from I-end to J-end. Use 0.0 for the I-end, 1.0 for the J-end, and a value between 0.0 and 1.0 for an intermediate position. The physical position is I + RATIO × (J - I).",
            "minimum": 0,
            "maximum": 1,
            "default": 0
          },
          "STRESS_TYPE": {
            "type": "string",
            "description": "Stress result to calculate over the beam section.",
            "enum": [
              "Normal",
              "VonMises",
              "Tauxy",
              "MaxShear",
              "Tauxz",
              "Princmax",
              "Princmin"
            ]
          },
          "COMPS": {
            "type": "array",
            "description": "Force/Moment Components",
            "default": [
              "ALL"
            ],
            "items": {
              "type": "string",
              "enum": [
                "Fx",
                "Fy",
                "Fz",
                "Mx",
                "My",
                "Mz"
              ]
            },
            "minItems": 1
          },
          "EXPORT_PATH": {
            "type": "string",
            "description": "Directory path to save the report files.",
            "minLength": 1
          },
          "OUTPUT_NAME": {
            "type": "string",
            "description": "Output file base name. For multiple elements, files are prefixed with index and element number (e.g. 001_E859_filename.jpg, 002_E1_filename.jpg).",
            "minLength": 1
          },
          "OUTPUT_OPTS": {
            "type": "object",
            "description": "Optional output settings. If OUTPUT_OPTS or an individual option is omitted, the corresponding result or diagram is generated by default.",
            "additionalProperties": false,
            "properties": {
              "DISP_DZ": {
                "type": "boolean",
                "description": "Return the Displacement Dz result.",
                "default": true
              },
              "DISP_DZ_DIAGRAM": {
                "type": "boolean",
                "description": "Return the Displacement Dz diagram.",
                "default": false
              },
              "SHEAR_FZ": {
                "type": "boolean",
                "description": "Return the Shear Force Fz result.",
                "default": true
              },
              "SHEAR_FZ_DIAGRAM": {
                "type": "boolean",
                "description": "Return the Shear Force Fz diagram.",
                "default": false
              },
              "MOMENT_MY": {
                "type": "boolean",
                "description": "Return the Bending Moment My result.",
                "default": true
              },
              "MOMENT_MY_DIAGRAM": {
                "type": "boolean",
                "description": "Return the Bending Moment My diagram.",
                "default": false
              },
              "DISP_DY": {
                "type": "boolean",
                "description": "Return the Displacement Dy result.",
                "default": true
              },
              "DISP_DY_DIAGRAM": {
                "type": "boolean",
                "description": "Return the Displacement Dy diagram.",
                "default": false
              },
              "SHEAR_FY": {
                "type": "boolean",
                "description": "Return the Shear Force Fy result.",
                "default": true
              },
              "SHEAR_FY_DIAGRAM": {
                "type": "boolean",
                "description": "Return the Shear Force Fy diagram.",
                "default": false
              },
              "MOMENT_MZ": {
                "type": "boolean",
                "description": "Return the Bending Moment Mz result.",
                "default": true
              },
              "MOMENT_MZ_DIAGRAM": {
                "type": "boolean",
                "description": "Return the Bending Moment Mz diagram.",
                "default": false
              },
              "LONG_SECT_STRESS": {
                "type": "boolean",
                "description": "Return the Longitudinal Section Stress result.",
                "default": true
              },
              "LONG_STRESS_DIAGRAM": {
                "type": "boolean",
                "description": "Return the Longitudinal Section Stress diagram.",
                "default": false
              },
              "CROSS_SECT_STRESS": {
                "type": "boolean",
                "description": "Return the Cross Section Stress result. Custom cross-section points are supported by GEN NX only.",
                "default": true
              },
              "CROSS_STRESS_DIAGRAM": {
                "type": "boolean",
                "description": "Return the Cross Section Stress diagram.",
                "default": false
              },
              "CROSS_SECT_POINTS": {
                "type": "array",
                "description": "GEN NX only. Cross-section evaluation points in the beam local section coordinate system. The section center is PY=0.0 and PZ=0.0. PY and PZ use the model's current length unit; positive directions follow the beam local +y and +z axes.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "PY": {
                      "type": "number",
                      "description": "Local y-coordinate measured from the section center (0.0).",
                      "default": 0
                    },
                    "PZ": {
                      "type": "number",
                      "description": "Local z-coordinate measured from the section center (0.0).",
                      "default": 0
                    }
                  }
                },
                "minItems": 1
              },
              "APPLIED_FORCE_MOM": {
                "type": "boolean",
                "description": "Return the Applied Forces/Moments result.",
                "default": true
              },
              "APPLIED_FM_DIAGRAM": {
                "type": "boolean",
                "description": "Return the Applied Forces/Moments diagram.",
                "default": false
              }
            }
          }
        }
      }
    }
  }
}
