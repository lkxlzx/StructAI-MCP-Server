{
  "key": "OPE.ISSD",
  "uri": "OPE/ISSD",
  "source": "civil_nx_manual",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Influence General Link Force/Moment Data Request",
    "type": "object",
    "description": "Request body for one general-link force or moment influence-line data result.",
    "required": [
      "Argument"
    ],
    "additionalProperties": false,
    "properties": {
      "Argument": {
        "type": "object",
        "description": "General-link force or moment influence data query arguments.",
        "required": [
          "KEY_ELEM",
          "COMPONENTS",
          "GENERAL_LINK_NODES"
        ],
        "additionalProperties": false,
        "properties": {
          "EXPORT_PATH": {
            "type": "string",
            "description": "Optional output file path. Supported extensions are .TXT and .JSON. When omitted, no file is saved. .TXT saves the original MIDAS text layout; .JSON saves the structured JSON result."
          },
          "UNIT": {
            "type": "object",
            "description": "Unit system used for the returned influence data.",
            "additionalProperties": false,
            "properties": {
              "FORCE": {
                "type": "string",
                "description": "Force unit, such as kN or N."
              },
              "DIST": {
                "type": "string",
                "description": "Distance unit, such as m or mm."
              }
            }
          },
          "LANE_NAME": {
            "type": "string",
            "description": "Selected line or surface lane name.",
            "default": "LANE all",
            "minLength": 1
          },
          "KEY_ELEM": {
            "type": "integer",
            "description": "Solid element number at which the stress influence is evaluated."
          },
          "COMPONENTS": {
            "type": "object",
            "properties": {
              "PART": {
                "type": "string",
                "enum": [
                  "Center",
                  "i",
                  "j",
                  "k",
                  "l",
                  "m",
                  "n",
                  "o",
                  "p"
                ],
                "default": "i"
              },
              "COMP": {
                "type": "string",
                "enum": [
                  "Sig-xx",
                  "Sig-yy",
                  "Sig-zz",
                  "Sig-xy",
                  "Sig-yz",
                  "Sig-xz"
                ],
                "default": "Sig-xx"
              }
            }
          },
          "OPT_INCLUDE_IMPACT_FACTOR": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  }
}
