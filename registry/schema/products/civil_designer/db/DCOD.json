{
  "key": "DB.DCOD",
  "uri": "DB/DCOD",
  "source": "civil_designer_manual",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "规范设置",
    "type": "object",
    "properties": {
      "DimType": {
        "type": "integer",
        "description": "设计内力<br>*0-二维 1-二维+扭矩 2-三维"
      },
      "SafeType": {
        "type": "integer",
        "description": "公路桥涵结构的设计安全等级<br>*0-一级 1-二级 2-三级"
      },
      "CastType": {
        "type": "integer",
        "description": "构件制作方法<br>*0-预制 1-现浇"
      },
      "BrgType": {
        "type": "integer",
        "description": "构件类型<br>*0-全预应力 1-A类 2-B类"
      },
      "CrackWidth": {
        "type": "array",
        "description": "环境设置<br>*0-I类-一般环境 1-II类-冻融环境 2-III类-海洋氯化物环境 3-IV类-除冰盐等其他氯化物环境 4-V类-盐结晶环境 5-VI类-化学腐蚀环境 6-VII类-磨蚀环境"
      },
      "CalcBtType": {
        "type": "integer",
        "description": "抗扭降低系数βt<br>*0-翼缘+腹板 1-腹板"
      },
      "Mesh": {
        "type": "boolean",
        "description": "是否采用网格划分"
      },
      "MeshSize": {
        "type": "number",
        "description": "网格尺寸"
      },
      "WeldSkeleton": {
        "type": "boolean",
        "description": "RC构件是否采用焊接钢筋骨架"
      },
      "WeldSkeletoFactor": {
        "type": "number",
        "description": "RC构件采用焊接钢筋骨架系数"
      },
      "Consider": {
        "type": "number",
        "description": "预应力弯起钢筋考虑"
      },
      "fcup": {
        "type": "number",
        "description": "施工阶段应力验算fcu’"
      },
      "MatlStrength": {
        "type": "integer",
        "description": "柱P-M验算材料强度<br>*0-标准值 1-设计值"
      },
      "Option1": {
        "type": "array",
        "description": "验算选项RC<br>*从上到下true-勾选 false-不勾选"
      },
      "Option2": {
        "type": "array",
        "description": "验算选项PSC<br>*从上到下true-勾选 false-不勾选"
      }
    }
  },
  "shape": "flat_object",
  "response": {
    "direction": "response",
    "source": "l4_measured_envelope",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "type": "object",
          "required": [
            "return_value"
          ],
          "properties": {
            "return_value": {}
          }
        }
      }
    }
  }
}
