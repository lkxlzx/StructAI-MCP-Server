{
  "key": "OPRT.DETAILREPORT",
  "uri": "OPRT/DETAILREPORT",
  "source": "civil_designer_manual",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "生成详细计算书",
    "type": "object",
    "properties": {
      "Type": {
        "type": "integer",
        "description": "详细计算书的目标构件<br>*0-全部构件 1-选择目标"
      },
      "SubType": {
        "type": "integer",
        "description": "目标构件类型<br>*Type==1时有效；<br>*0-构件Key 1-单元Key对应构件2-构件名称"
      },
      "NameList": {
        "type": "array",
        "description": "构件名称<br>*Type==1且SubType==2时有效"
      },
      "KeyList": {
        "type": "array",
        "description": "构件/单元Key<br>*Type==1且SubType==0,1时有效"
      },
      "ProjectName": {
        "type": "string",
        "description": "项目名称"
      },
      "Date": {
        "type": "string",
        "description": "日期"
      },
      "Company": {
        "type": "string",
        "description": "公司名"
      },
      "Designer": {
        "type": "string",
        "description": "设计者"
      },
      "Checker": {
        "type": "string",
        "description": "复核者"
      },
      "Examiner": {
        "type": "string",
        "description": "审批者"
      },
      "Content": {
        "type": "string",
        "description": "计算内容"
      },
      "Other": {
        "type": "string",
        "description": "其他"
      },
      "FilePath": {
        "type": "string",
        "description": "输出路径<br>*未设置时用默认路径"
      },
      "Option1": {
        "type": "array",
        "description": "输出选项1<br>*两个验算选项列表时，左侧验算选项列表；一个验算选项列表时的验算选项列表"
      },
      "Option2": {
        "type": "array",
        "description": "输出选项2<br>*两个验算选项列表时，右侧验算选项列表"
      },
      "Open": {
        "type": "boolean",
        "description": "是否打开报告"
      }
    },
    "required": [
      "Type"
    ]
  },
  "shape": "flat_object"
}
