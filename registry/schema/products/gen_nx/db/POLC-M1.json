                        "DX",
                        "DY",
                        "DZ"
                      ],
                      "description": "Direction (DB 1/2/3 ↔ DTO 0/1/2 offset 변환 (handler 자동))"
                    },
                    "MASTERMAXDISP": {
                      "type": "number",
                      "not": {
                        "const": 0
                      },
                      "description": "Max. Displacement (값 != 0.0 필수)"
                    },
                    "STIFF_RATIO": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100,
                      "description": "Current Stiffness Ratio (Cs) ([0, 100] 범위. UI는 Figure 서브 대화상자에서 설정)"
