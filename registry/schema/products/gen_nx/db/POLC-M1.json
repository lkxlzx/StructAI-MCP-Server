{
  "key": "DB.POLC-M1",
  "uri": "DB/POLC-M1",
  "source": "help_center",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "Assign"
    ],
    "properties": {
      "Assign": {
        "type": "object",
        "description": "Keys are string indices; each value is a Pushover Load Case (Add/Modify) request item (gvs1: SSOT planner).",
