                "LCNAME",
                "INCRE_STEP",
                "NLTYPE",
                "bUSEINITIAL",
                "INCRE_METHOD",
                "CTRL_OPT",
                "LOADPATTERNTYPE",
                "LOADPATTERN"
              ],
              "properties": {
                "LCNAME": {
                  "type": "string",
                  "description": "Name (길이 1~20, 중복 불가)"
                },
                "DESC": {
                  "type": "string",
                  "default": "",
                  "description": "Description (길이 ≤80)"
                },
                "INCRE_STEP": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Increment Steps (nstep) (값 > 0. UI 기본 20)"
                },
                "NLTYPE": {
                  "type": "string",
                  "enum": [
                    "NONE",
                    "PDELTA",
                    "LARGE"
