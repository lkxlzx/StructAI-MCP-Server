                        },
                        "required": [
                          "STEPCTRLOPTION"
                        ]
                      },
                      "then": {
                        "required": [
                          "INCFUNC_NAME"
                        ]
                      }
                    },
                    {
                      "description": "When STEPCTRLOPTION = AUTO or EQUAL, INCFUNC_NAME must not be provided",
