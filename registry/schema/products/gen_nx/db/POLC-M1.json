                  },
                  "allOf": [
                    {
                      "description": "When STEPCTRLOPTION = INC_FUNC, INCFUNC_NAME is required",
                      "if": {
                        "properties": {
                          "STEPCTRLOPTION": {
                            "const": "INC_FUNC"
