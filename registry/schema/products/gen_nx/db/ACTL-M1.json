                        },
                        "VALUE": {
                          "type": "number",
                          "description": "Displacement (U) / Load (P) / Work (W)"
                        }
                      },
                      "allOf": [
                        {
                          "description": "If OPT_USE = true, VALUE is required.",
                          "if": {
                            "properties": {
                              "OPT_USE": {
                                "const": true
                              }
                            },
                            "required": [
                              "OPT_USE"
                            ]
                          },
                          "then": {
                            "required": [
                              "VALUE"
                            ]
                          }
                        },
                        {
                          "description": "If OPT_USE = false, VALUE is not allowed.",
                          "if": {
                            "properties": {
                              "OPT_USE": {
                                "const": false
                              }
                            },
                            "required": [
                              "OPT_USE"
                            ]
                          },
                          "then": {
                            "not": {
                              "required": [
                                "VALUE"
                              ]
                            }
                          }
                        }
                      ],
                      "description": "Displacement (U) / Load (P) / Work (W)"
                    }
                  },
                  "anyOf": [
                    {
                      "properties": {
                        "DISPL": {
                          "properties": {
                            "OPT_USE": {
                              "const": true
                            }
                          },
                          "required": [
