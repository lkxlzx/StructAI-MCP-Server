                              "const": true
                            }
                          },
                          "required": [
                            "OPT_USE"
                          ]
                        }
                      },
                      "required": [
                        "LOAD"
                      ]
                    },
                    {
                      "properties": {
                        "WORK": {
                          "properties": {
                            "OPT_USE": {
                              "const": true
                            }
                          },
                          "required": [
                            "OPT_USE"
                          ]
                        }
                      },
                      "required": [
                        "WORK"
                      ]
                    }
                  ],
                  "description": "Displacement (U) / Load (P) / Work (W)"
                }
              },
              "description": "Tension/Compression Truss Element (서브다이얼로그 진입 — API 는 TCELEM 블록 직접 전송)"
            }
          }
        }
