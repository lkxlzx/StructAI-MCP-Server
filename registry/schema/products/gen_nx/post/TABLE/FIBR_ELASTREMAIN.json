                  "type": "string",
                  "description": "Length"
                },
                "HEAT": {
                  "type": "string",
                  "description": "Heat"
                },
                "TEMP": {
                  "type": "string",
                  "description": "Temperature"
                }
              }
            },
            "STYLES": {
